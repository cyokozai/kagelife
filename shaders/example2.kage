//kage:unit pixels
package main

var Time float
var Resolution vec2

// 2D回転
func rot(p vec2, a float) vec2 {
	return vec2(p.x*cos(a)-p.y*sin(a), p.x*sin(a)+p.y*cos(a))
}

// Kage の atan は1引数のみのため atan2 を自前実装
func atan2f(y, x float) float {
	pi := 3.14159265358979
	if abs(x) < 0.00001 {
		if y >= 0.0 {
			return pi * 0.5
		}
		return pi * -0.5
	}
	a := atan(y / x)
	if x < 0.0 {
		if y >= 0.0 {
			return a + pi
		}
		return a - pi
	}
	return a
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// 中心原点・アスペクト比補正
	uv := (dstPos.xy*2.0 - Resolution) / min(Resolution.x, Resolution.y)

	// 極座標へ変換
	ang := atan2f(uv.y, uv.x)
	radius := length(uv)

	// カレイドスコープ: 8分割で折り畳む
	angStep := 3.14159265 * 2.0 / 8.0
	ang = mod(ang, angStep)
	ang = abs(ang - angStep*0.5)
	uv = vec2(cos(ang), sin(ang)) * radius

	t := Time * 0.2

	// --- 3層の波パターン ---

	// 層1: ゆっくり回転する格子波
	p1 := rot(uv, t)
	layer1 := sin(p1.x*12.0+t*3.0) * sin(p1.y*12.0-t*2.0)

	// 層2: 逆回転する同心リング＋角度変調
	p2 := rot(uv, -t*0.7+1.0)
	layer2 := sin(length(p2)*18.0 - t*5.0 + sin(ang*3.0))

	// 層3: 渦巻きトンネル
	spiral := ang*4.0 + radius*8.0 - Time*2.0
	layer3 := sin(spiral)

	// 合成して 0〜1 に正規化
	v := layer1*0.4 + layer2*0.4 + layer3*0.2
	v = v*0.5 + 0.5

	// --- RGB着色: 位相を120°ずらして虹色サイクル ---
	speed := Time * 0.6
	phase := v * 6.28318
	cr := sin(phase+speed+0.000) * 0.5 + 0.5
	cg := sin(phase+speed+2.094) * 0.5 + 0.5
	cb := sin(phase+speed+4.189) * 0.5 + 0.5

	// ズームパルス（拍動感）
	pulse := 1.0 + sin(Time*1.5)*0.06

	// 周辺減光ビネット
	vignette := 1.0 - smoothstep(0.55, 1.1, radius)

	bright := pulse * vignette
	return vec4(
		clamp(cr*bright, 0.0, 1.0),
		clamp(cg*bright, 0.0, 1.0),
		clamp(cb*bright, 0.0, 1.0),
		1.0,
	)
}
