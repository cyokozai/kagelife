//kage:unit pixels
package main

var Time float
var Beat float
var Resolution vec2

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := dstPos.xy / Resolution
	uv = uv*2.0 - 1.0
	uv.x *= Resolution.x / Resolution.y

	d := length(uv)
	ring := sin(d*22.0 - Time*5.0)
	ring = pow(0.5+0.5*ring, 6.0)

	col := mix(vec3(0.05, 0.0, 0.2), vec3(1.0, 0.5, 0.85), ring)
	col *= 1.0 - d*0.5
	col *= 1.0 + (1.0-Beat)*20.0
	return vec4(col, 1.0)
}
