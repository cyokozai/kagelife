//kage:unit pixels
package main

var Cursor vec2
var Resolution vec2
var Time float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	uv := dstPos.xy / Resolution
	cur := Cursor / Resolution
	d := length(uv - cur)

	light := 0.15 / (d + 0.05)
	tint := vec3(
		0.5+sin(Time)*0.5,
		0.5+sin(Time+2.0)*0.5,
		0.5+sin(Time+4.0)*0.5,
	)
	return vec4(tint*light, 1.0)
}
